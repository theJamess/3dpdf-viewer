+/* Built instead of step_import.cpp when demos/viewer/CMakeLists.txt did not
+   find OpenCASCADE at configure time -- see that file for the selection
+   logic. Keeps the menu item itself unconditional in main.cpp (always
+   visible, so its absence is never a silent "why isn't this here"), with
+   the explanation surfacing only when actually invoked. */
+
+bool StepImportAvailable()
+{
+    return false;
+}
+
+bool ImportStepToTempPdf(const char *, std::string &, std::string &out_error)
+{
+    out_error = "This build of the viewer was compiled without STEP import "
+        "support (OpenCASCADE was not found when it was built). Install "
+        "libocct-data-exchange-dev and rebuild to enable it.";
+    return false;
+}
