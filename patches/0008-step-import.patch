+/* Runs an external program with argv, no shell involved (so no quoting/
+   injection concerns regardless of what ends up in argv -- a user-chosen
+   file path, for instance) and captures its stdout. Returns the captured
+   output (trailing newline stripped) on a zero exit status, empty string
+   otherwise (covers both "program not found" and "user cancelled", which
+   is exactly right for both zenity uses below: cancelling the file picker
+   or dismissing the error dialog should look the same as zenity not being
+   installed at all -- nothing more to do). */
+static std::string runCaptureStdout(const std::vector<std::string> &argv)
+{
+    int pipefd[2];
+    if (pipe(pipefd) != 0)
+        return std::string();
+
+    pid_t pid = fork();
+    if (pid < 0)
+    {
+        close(pipefd[0]);
+        close(pipefd[1]);
+        return std::string();
+    }
+
+    if (pid == 0)
+    {
+        /* Child: stdout -> pipe write end, exec. */
+        close(pipefd[0]);
+        dup2(pipefd[1], STDOUT_FILENO);
+        close(pipefd[1]);
+
+        std::vector<char *> cargv;
+        for (const std::string &s : argv)
+            cargv.push_back(const_cast<char *>(s.c_str()));
+        cargv.push_back(nullptr);
+
+        execvp(cargv[0], cargv.data());
+        _exit(127); /* execvp only returns on failure */
+    }
+
+    /* Parent */
+    close(pipefd[1]);
+    std::string output;
+    char buf[256];
+    ssize_t n;
+    while ((n = read(pipefd[0], buf, sizeof(buf))) > 0)
+        output.append(buf, (size_t)n);
+    close(pipefd[0]);
+
+    int status = 0;
+    waitpid(pid, &status, 0);
+
+    while (!output.empty() && (output.back() == '\n' || output.back() == '\r'))
+        output.pop_back();
+
+    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+        return std::string();
+
+    return output;
+}
+
+static std::string pickStepFileViaZenity()
+{
+    return runCaptureStdout({
+        "zenity", "--file-selection", "--title=Import from STEP",
+        "--file-filter=STEP files | *.step *.stp *.STEP *.STP"
+    });
+}
+
+static void showImportErrorDialog(const std::string &message)
+{
+    runCaptureStdout({ "zenity", "--error", "--title=Import from STEP",
+        "--text=" + message });
+}
+
+/* Set from the File menu; handled once per frame, after rendering (same
+   deferred-to-after-render pattern as g_screenshotRequested below) rather
+   than inline in the menu callback, since a successful import ends the
+   process (see the handler). */
+static bool g_stepImportRequested = false;
+
+/* No hot-reload of an already-running Scene -- Scene::load() calls exit(1)
+   on any internal failure (it was written as a one-shot startup path, see
+   scene.cpp), so making it safely re-enterable would mean auditing and
+   rewriting every one of those failure paths. Relaunching the whole
+   process with the converted file as its new argument reuses that exact,
+   already-proven startup path instead of adding a second, less-tested one
+   -- the cost is losing the current camera/view state, which is what
+   opening any other new file would do anyway. */
+static void handleStepImportRequest()
+{
+    if (!StepImportAvailable())
+    {
+        showImportErrorDialog(
+            "This build of the viewer was compiled without STEP import "
+            "support (OpenCASCADE was not found when it was built).");
+        return;
+    }
+
+    std::string stepPath = pickStepFileViaZenity();
+    if (stepPath.empty())
+        return; /* cancelled, or zenity unavailable -- printed to stderr by the caller below in that second case */
+
+    std::string pdfPath, error;
+    if (!ImportStepToTempPdf(stepPath.c_str(), pdfPath, error))
+    {
+        showImportErrorDialog(error);
+        return;
+    }
+
+    /* argv[0] is not reliably an executable path (may be just a bare
+       command name resolved via PATH, or relative) -- /proc/self/exe is
+       the actual running binary regardless of how it was invoked. */
+    char selfPath[4096];
+    ssize_t len = readlink("/proc/self/exe", selfPath, sizeof(selfPath) - 1);
+    if (len <= 0)
+    {
+        showImportErrorDialog("Converted the file, but could not relaunch the viewer to show it (couldn't resolve the running executable's own path). The converted PDF was left at: " + pdfPath);
+        return;
+    }
+    selfPath[len] = '\0';
+
+    char *newArgv[3];
+    newArgv[0] = selfPath;
+    newArgv[1] = const_cast<char *>(pdfPath.c_str());
+    newArgv[2] = nullptr;
+    execv(selfPath, newArgv);
+
+    /* Only reached if execv itself failed to start the new process. */
+    showImportErrorDialog("Converted the file, but could not relaunch the viewer to show it. The converted PDF was left at: " + pdfPath);
+}
