+}
+
+namespace
+{
+
+/* One PRC part's worth of flattened triangle data, built from one STEP
+   solid. Kept as a struct (rather than writing straight into the
+   prc_api_write_* arrays) because those arrays need to stay alive,
+   unmoved, until prc_api_write_prc_buffer returns -- easiest to guarantee
+   by owning them in a vector of these that outlives that call. */
+struct SolidMesh
+{
+    std::string name;
+    std::vector<double> positions;
+    std::vector<uint32_t> triIndices;
+    std::vector<uint32_t> faceTriCounts;
+    double bboxMin[3];
+    double bboxMax[3];
+};
+
+/* Flattens every face's triangulation of one TopoDS_Shape (a single solid,
+   or the whole multi-solid shape for the fallback no-solids case) into one
+   SolidMesh, applying each face's own placement and orientation. Returns
+   false (mesh left however far it got) if the shape has no triangulated
+   faces at all -- BRepMesh_IncrementalMesh must have already run on the
+   OWNING top-level shape before this is called; TopoDS_Face triangulation
+   lives on the face regardless of which sub-shape explorer reached it. */
+bool FlattenShapeToMesh(const TopoDS_Shape &shape, SolidMesh &mesh)
+{
+    for (TopExp_Explorer exp(shape, TopAbs_FACE); exp.More(); exp.Next())
+    {
+        TopoDS_Face face = TopoDS::Face(exp.Current());
+        TopLoc_Location loc;
+        Handle(Poly_Triangulation) tri = BRep_Tool::Triangulation(face, loc);
+        if (tri.IsNull())
+            continue;
+
+        const gp_Trsf &trsf = loc.Transformation();
+        uint32_t base = (uint32_t)(mesh.positions.size() / 3);
+
+        for (Standard_Integer i = 1; i <= tri->NbNodes(); i++)
+        {
+            gp_Pnt p = tri->Node(i);
+            p.Transform(trsf);
+            mesh.positions.push_back(p.X());
+            mesh.positions.push_back(p.Y());
+            mesh.positions.push_back(p.Z());
+        }
+
+        /* STEP/OCCT faces can be reversed relative to their surface's
+           natural parametrization -- winding must flip to match, or this
+           face's normal (computed by nanoPRC's recalculated-normals path
+           from winding order) points inward. */
+        bool reversed = (face.Orientation() == TopAbs_REVERSED);
+
+        for (Standard_Integer i = 1; i <= tri->NbTriangles(); i++)
+        {
+            Standard_Integer n1, n2, n3;
+            tri->Triangle(i).Get(n1, n2, n3);
+            if (reversed) std::swap(n2, n3);
+            mesh.triIndices.push_back(base + (n1 - 1));
+            mesh.triIndices.push_back(base + (n2 - 1));
+            mesh.triIndices.push_back(base + (n3 - 1));
+        }
+        mesh.faceTriCounts.push_back((uint32_t)tri->NbTriangles());
+    }
+
+    return !mesh.triIndices.empty();
+}
+
+} // namespace
+
+bool ImportStepToTempPdf(const char *step_path, std::string &out_pdf_path, std::string &out_error)
+{
+    STEPControl_Reader reader;
+    if (reader.ReadFile(step_path) != IFSelect_RetDone)
+    {
+        out_error = "Could not read this file as STEP (ISO 10303) -- it may be malformed or not actually a STEP file.";
+        return false;
+    }
+    reader.TransferRoots();
+    TopoDS_Shape shape = reader.OneShape();
+    if (shape.IsNull())
+    {
+        out_error = "STEP file read, but it contains no usable geometry.";
+        return false;
+    }
+
+    /* 0.1 (file-native-unit) linear deflection -- STEP files are
+       overwhelmingly authored in mm, so this is a reasonably fine mesh for
+       typical mechanical-part sizes; not adaptive to model scale. */
+    BRepMesh_IncrementalMesh mesher(shape, 0.1, Standard_False, 0.5, Standard_True);
+
+    std::vector<SolidMesh> solids;
+    int solidIndex = 0;
+    for (TopExp_Explorer exp(shape, TopAbs_SOLID); exp.More(); exp.Next())
+    {
+        solidIndex++;
+        SolidMesh mesh;
+        mesh.name = "Solid " + std::to_string(solidIndex);
+        if (FlattenShapeToMesh(exp.Current(), mesh))
+        {
+            Bnd_Box bbox;
+            BRepBndLib::Add(exp.Current(), bbox);
+            bbox.Get(mesh.bboxMin[0], mesh.bboxMin[1], mesh.bboxMin[2],
+                     mesh.bboxMax[0], mesh.bboxMax[1], mesh.bboxMax[2]);
+            solids.push_back(std::move(mesh));
+        }
+    }
+
+    /* Some STEP files (e.g. a single-body part with no explicit SOLID
+       wrapper) have triangulated faces directly under the root shape with
+       no TopAbs_SOLID in between -- fall back to treating the whole shape
+       as one part rather than silently producing an empty PDF. */
+    if (solids.empty())
+    {
+        SolidMesh mesh;
+        mesh.name = "Solid 1";
+        if (!FlattenShapeToMesh(shape, mesh))
+        {
+            out_error = "STEP file read and tessellated, but no triangulated faces resulted -- the geometry may be degenerate.";
+            return false;
+        }
+        Bnd_Box bbox;
+        BRepBndLib::Add(shape, bbox);
+        bbox.Get(mesh.bboxMin[0], mesh.bboxMin[1], mesh.bboxMin[2],
+                 mesh.bboxMax[0], mesh.bboxMax[1], mesh.bboxMax[2]);
+        solids.push_back(std::move(mesh));
+    }
+
+    prc_context *ctx = prc_api_new_context(NULL);
+    if (ctx == NULL)
+    {
+        out_error = "Internal error: could not create a PRC write context.";
+        return false;
+    }
+
+    std::vector<prc_api_write_tessellation> tessEntries(solids.size());
+    std::vector<prc_api_write_rep_item> repItems(solids.size());
+    std::vector<prc_api_write_node> childNodes(solids.size());
+    std::vector<prc_api_write_node *> childPtrs(solids.size());
+
+    double rootMin[3] = { 1e300, 1e300, 1e300 };
+    double rootMax[3] = { -1e300, -1e300, -1e300 };
+
+    for (size_t i = 0; i < solids.size(); i++)
+    {
+        const SolidMesh &s = solids[i];
+
+        prc_api_write_tessellation &t = tessEntries[i];
+        memset(&t, 0, sizeof(t));
+        t.kind = PRC_API_WRITE_TESS_KIND_COMPRESSED;
+        t.positions = s.positions.data();
+        t.num_positions = (uint32_t)(s.positions.size() / 3);
+        t.tri_indices = s.triIndices.data();
+        t.num_triangles = (uint32_t)(s.triIndices.size() / 3);
+        t.face_tri_counts = s.faceTriCounts.data();
+        t.num_faces = (uint32_t)s.faceTriCounts.size();
+        t.crease_angle_degrees = 30.0;
+
+        prc_api_write_rep_item &ri = repItems[i];
+        memset(&ri, 0, sizeof(ri));
+        ri.kind = PRC_API_WRITE_RI_SURFACE;
+        ri.biased_tessellation_index = (uint32_t)(i + 1);
+
+        prc_api_write_node &node = childNodes[i];
+        memset(&node, 0, sizeof(node));
+        node.rep_items = &repItems[i];
+        node.num_rep_items = 1;
+        node.bbox_min[0] = s.bboxMin[0]; node.bbox_min[1] = s.bboxMin[1]; node.bbox_min[2] = s.bboxMin[2];
+        node.bbox_max[0] = s.bboxMax[0]; node.bbox_max[1] = s.bboxMax[1]; node.bbox_max[2] = s.bboxMax[2];
+        node.name = s.name.c_str();
+        node.part_name = s.name.c_str();
+
+        childPtrs[i] = &childNodes[i];
+
+        for (int k = 0; k < 3; k++)
+        {
+            rootMin[k] = std::min(rootMin[k], s.bboxMin[k]);
+            rootMax[k] = std::max(rootMax[k], s.bboxMax[k]);
+        }
+    }
+
+    /* Base name on the source file (matching how the app's own File>Open
+       names things), not the fixed string "model". */
+    std::string baseName = step_path;
+    size_t slashPos = baseName.find_last_of("/\\");
+    if (slashPos != std::string::npos) baseName = baseName.substr(slashPos + 1);
+    size_t dotPos = baseName.find_last_of('.');
+    if (dotPos != std::string::npos) baseName = baseName.substr(0, dotPos);
+    if (baseName.empty()) baseName = "Imported STEP";
+
+    prc_api_write_node root;
+    memset(&root, 0, sizeof(root));
+    root.bbox_min[0] = rootMin[0]; root.bbox_min[1] = rootMin[1]; root.bbox_min[2] = rootMin[2];
+    root.bbox_max[0] = rootMax[0]; root.bbox_max[1] = rootMax[1]; root.bbox_max[2] = rootMax[2];
+    root.name = baseName.c_str();
+
+    /* One flat part for the common single-solid case (matches how a
+       normal PRC file names its one part after the model, rather than
+       wrapping it in a redundant "Solid 1" sub-node); an assembly of
+       per-solid children otherwise. */
+    if (solids.size() == 1)
+    {
+        root.rep_items = &repItems[0];
+        root.num_rep_items = 1;
+        root.part_name = baseName.c_str();
+    }
+    else
+    {
+        root.children = childPtrs.data();
+        root.num_children = (uint32_t)childPtrs.size();
+    }
+
+    uint8_t *buf = NULL;
+    size_t bufSize = 0;
+    int code = prc_api_write_prc_buffer(ctx, baseName.c_str(), &root,
+        tessEntries.data(), (uint32_t)tessEntries.size(), &buf, &bufSize);
+    if (code < 0)
+    {
+        out_error = "Failed writing the converted geometry as PRC (internal error code " + std::to_string(code) + ").";
+        prc_api_release_context(ctx);
+        return false;
+    }
+
+    char tmpPath[] = "/tmp/3dpdf-viewer-import-XXXXXX.pdf";
+    /* mkstemps (not mkstemp) to keep the .pdf suffix -- nano_prc_viewer
+       and bin/3dpdf-view both dispatch on file extension. */
+    int fd = mkstemps(tmpPath, 4);
+    if (fd < 0)
+    {
+        out_error = "Could not create a temporary file for the converted PDF.";
+        prc_api_write_prc_buffer_free(ctx, buf);
+        prc_api_release_context(ctx);
+        return false;
+    }
+    close(fd); /* prc_api_pdf_embed_prc opens the path itself -- this fd was only to claim the unique name safely. */
+
+    code = prc_api_pdf_embed_prc(ctx, tmpPath, buf, bufSize, NULL);
+    prc_api_write_prc_buffer_free(ctx, buf);
+    if (code < 0)
+    {
+        out_error = "Converted the geometry, but failed embedding it into a PDF (internal error code " + std::to_string(code) + ").";
+        prc_api_release_context(ctx);
+        unlink(tmpPath);
+        return false;
+    }
+
+    prc_api_release_context(ctx);
+    out_pdf_path = tmpPath;
+    return true;
+}
