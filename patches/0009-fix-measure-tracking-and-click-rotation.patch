+/* Point-to-point/angle measurement: a successful Ctrl+LeftClick pick (see
+   Triangle Pick above) auto-fills the first empty slot of A/B/C; the
+   "Set Point A/B/C from last pick" buttons in the Measure tab exist to
+   *re*-assign one specific slot from the last pick (e.g. to fix a
+   mis-placed point without redoing the other two), not as the only way
+   to set a point.
+
+   Each point is stored as (product, localHitPos) -- the pick's local-space
+   position within whatever product it landed on -- rather than a single
+   cached world-space position. Rotating/panning in this viewer moves the
+   *product* (see the arcball/pan code above setting _scene.models()[0]'s
+   own model matrix), not the camera, so a world-space position captured
+   at pick time goes stale the moment the user rotates again: the point
+   stays fixed in world space while the surface it was picked on moves out
+   from under it. Re-deriving the world position every frame via the
+   product's *current* localToWorld() keeps the point visually attached to
+   the surface no matter how the model has since been rotated/panned.
 
    Distances/coordinates here are in FILE UNITS, not millimeters. PRC does
    carry a per-file CAD-unit scale (units_from_CAD_flag/units_from_CAD_file
@@ -369,11 +393,32 @@ static bool pickTriangleAtScreenPoint(int mouseX, int mouseY, int viewportW,
 struct MeasurePoint
 {
     bool valid;
-    Vector3 pos;
+    Product *product;
+    Vector3 localPos;
 };
 
 static MeasurePoint g_measurePoints[3] = { { false }, { false }, { false } };
 
+/* The point's world-space position *right now*, re-derived from its
+   product's current transform rather than a stale cached value -- see the
+   MeasurePoint comment above. */
+static Vector3 measurePointWorldPos(const MeasurePoint &mp)
+{
+    if (mp.product == nullptr)
+        return mp.localPos;
+    return transformPoint(mp.product->localToWorld(), mp.localPos);
+}
+
+/* First index in g_measurePoints that isn't set yet, or -1 if A/B/C are
+   all already occupied. */
+static int firstEmptyMeasureSlot()
+{
+    for (int i = 0; i < 3; i++)
+        if (!g_measurePoints[i].valid)
+            return i;
+    return -1;
+}
+
