             };
@@ -349,10 +360,23 @@ static bool pickTriangleAtScreenPoint(int mouseX, int mouseY, int viewportW,
     return best.valid;
 }
 
-/* Point-to-point/angle measurement: reuses g_lastPick's world-space hit
