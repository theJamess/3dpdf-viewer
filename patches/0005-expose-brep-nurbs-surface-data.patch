From 6ac39f5d4cf66fc00bbf1b013ee9187c53307b22 Mon Sep 17 00:00:00 2001
From: 3dpdf <3dpdf@users.noreply.github.com>
Date: Sun, 20 Sep 2026 14:44:26 +0000
Subject: [PATCH] Expose uncompressed B-Rep NURBS surface data through a new
 public API

Adds prc_api_get_number_brep_bodies/_shells/_faces, prc_api_get_face_
surface_type, prc_api_get_face_nurbs_surface, and prc_api_release_
nurbs_surface: a face's exact mathematical surface (degree, control
points with weights, knot vectors in both parametric directions) is
now readable directly, not just as tessellated triangles.

nanoPRC already parses this data in full (prc_parse_surf_nurbs) and
already evaluates it internally (prc_evaluate_surf_nurbs) to build
tessellations -- it just never handed it back out. This only copies
already-parsed fields into a public-facing struct; no new geometry
math.

SCOPE, the significant limitation: only PRC_TYPE_TOPO_BrepData bodies
(the *uncompressed* B-Rep encoding) with exactly one connex and every
connex/shell/face link stored inline are addressable at all -- the
same restriction nanoPRC's own tessellator applies before it will
tessellate a BrepData body (prc_approximate_objects_exact_geom). Within
an addressable body, only PRC_TYPE_SURF_NURBS faces decode to real
data; every other analytic surface type (Plane, Cylinder, Cone, ...)
reports PRC_API_SURFACE_UNKNOWN, as does anything reached through
PRC_TYPE_TOPO_BrepDataCompress -- the *compressed* B-Rep encoding most
real-world CAD-authored 3D PDFs actually use, which reconstructs each
face's geometry through a bespoke per-face-type synthesis process this
patch does not decode. Checked against this project's own 7 test
files via tests/internal/brep_entity_census: only cylinder.pdf has an
addressable uncompressed body at all, and its one face is an analytic
Cylinder, not NURBS -- so on every file this project has on hand,
including the one that does have usable uncompressed geometry, this
API currently returns UNKNOWN. That is a real, known, and currently
permanent limitation, not a bug.

Indexing design note: an earlier version of this patch addressed
bodies through data->exact_geom_tess_part, the same index
prc_api_get_exact_geometry_tessellation_vertices uses. That array is
only populated as a side effect of prc_api_prep_model_tree, and only
for representation items with NO regular tessellation of their own
(nanoPRC's fallback path for tessellation-free files). Real files
overwhelmingly ship a pre-baked tessellation alongside their exact
geometry -- cylinder.pdf included -- so that indexing was empty for
every file tested, in practice a no-op rather than reduced coverage.
prc_api_get_number_brep_bodies instead walks each file structure's
FileStructureExactGeometry section directly, independent of whether a
tessellation exists, and needs no prep_model_tree call first.

Also fixes the doc comment on control-point ordering: it read
"row-major order (u varies fastest)", which is backwards from
prc_evaluate_surf_nurbs's own indexing (index = ctrl_u * num_ctrl_v +
ctrl_v -- u varies SLOWEST, v fastest, i.e. u-major). Caught by writing
tests/internal/check_nurbs_surface_api_unit.c against known input and
noticing the doc comment disagreed with the working code.

Verification:
- tests/internal/check_nurbs_surface_api_unit.c: hand-builds a minimal
  in-memory prc_data (no parser, no file I/O) with a known non-rational
  and a known rational NURBS patch, and checks the API returns the fed-
  in degree/control-points/knots exactly, that non-rational control_w
  reads back as 1.0, and that out-of-range indices fail cleanly. This
  exists because no available sample PDF exercises the NURBS path (see
  SCOPE above) -- it covers the code this patch actually adds (the
  body/shell/face walk and the struct-to-public-API copy), not the
  pre-existing parser. Passes clean under valgrind --leak-check=full
  (0 errors, all allocations freed).
- tests/internal/check_nurbs_surface_api.c: runs the real API against
  an actual file (cylinder.pdf), also valgrind-clean; confirms the
  Cylinder-not-NURBS UNKNOWN result via independent cross-check against
  brep_entity_census's surface-type census.
- scan_prc against all 7 project test files (3 bundled examples +
  enclosure.pdf + 3 Tetra4D samples): unchanged tessellation output,
  no regression from the header/API additions.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 include/prc_api.h                             | 194 ++++++++++
 src/prc_tri_primitives_api.c                  | 331 ++++++++++++++++++
 tests/internal/CMakeLists.txt                 |   8 +
 tests/internal/check_nurbs_surface_api.c      | 250 +++++++++++++
 tests/internal/check_nurbs_surface_api_unit.c | 316 +++++++++++++++++
 5 files changed, 1099 insertions(+)
 create mode 100644 tests/internal/check_nurbs_surface_api.c
 create mode 100644 tests/internal/check_nurbs_surface_api_unit.c

diff --git a/include/prc_api.h b/include/prc_api.h
index 15688dc..015c74d 100644
--- a/include/prc_api.h
+++ b/include/prc_api.h
@@ -670,6 +670,200 @@ PRC_EXPORT int prc_api_get_exact_geometry_tessellation_vertices(prc_context *ctx
  */
 PRC_EXPORT void prc_api_release_exact_geometry_tessellation(prc_context *ctx, prc_api_tess *tess);
 
+/**
+ * @brief Exact-geometry surface types this API can report/expose.
+ *
+ * Deliberately much smaller than PRC_TYPE_SURF_* (src/prc_data.h): this
+ * only names the cases prc_api_get_face_surface_type and
+ * prc_api_get_face_nurbs_surface actually recognize today. Every other
+ * surface shape -- including NURBS faces reached through PRC's
+ * *compressed* B-Rep body encoding (PRC_TYPE_TOPO_BrepDataCompress; see
+ * the SCOPE note on prc_api_get_face_surface_type) -- reports UNKNOWN,
+ * even though such a face tessellates and displays completely normally
+ * through prc_api_get_exact_geometry_tessellation_vertices. UNKNOWN here
+ * means "not exposed by this API", not "malformed" or "unsupported by
+ * the renderer".
+ */
+typedef enum
+{
+    PRC_API_SURFACE_UNKNOWN = 0,
+    PRC_API_SURFACE_NURBS = 1
+} prc_api_surface_type;
+
+/**
+ * @brief Number of B-Rep bodies this API's face/surface functions can
+ * address, across every file structure in the loaded document.
+ *
+ * This indexes PRC_TYPE_TOPO_BrepData bodies directly out of each file
+ * structure's exact-geometry section (FileStructureExactGeometry, Table
+ * 50) -- it does NOT go through the model tree, and does NOT require
+ * prc_api_prep_model_tree/prc_api_create_model_tree to have been called
+ * first. That matters: an earlier version of this API reused the
+ * exact_geom_tess_part indexing prc_api_get_exact_geometry_tessellation_
+ * vertices addresses, which is only populated for representation items
+ * that have NO regular tessellation of their own (nanoPRC's fallback path
+ * for tessellation-free files). Real-world 3D PDFs -- including ones with
+ * perfectly usable uncompressed BrepData, like this project's own
+ * examples/cylinder.pdf -- almost always ship a pre-baked tessellation
+ * alongside their exact geometry, so that indexing was empty for them in
+ * practice: not merely reduced coverage, but the API doing nothing on the
+ * files it was meant for. This index space is independent of whether a
+ * tessellation exists, so it sees a body's exact geometry whether or not
+ * the file also carries a rendered mesh for it.
+ *
+ * A body only gets an index here if it also passes the same restriction
+ * prc_api_get_face_surface_type documents: exactly one connex, and every
+ * connex/shell/face link in the chain stored inline rather than
+ * referenced. A body that fails that restriction (multi-connex, or any
+ * PRC_TYPE_TOPO_BrepDataCompress body -- see that same SCOPE note) is not
+ * counted and has no index at all, rather than an index that then reports
+ * UNKNOWN/zero shells; use tests/internal's brep_entity_census tool if you
+ * need to know ahead of time how many of a file's bodies will be in scope.
+ *
+ * @param ctx Active API context.
+ * @param data_in Data handle from prc_api_open_contents.
+ * @return Number of addressable B-Rep bodies (0 or more), or 0 on a NULL/
+ *         invalid data handle.
+ */
+PRC_EXPORT uint32_t prc_api_get_number_brep_bodies(prc_context *ctx, prc_api_data data_in);
+
+/**
+ * @brief Number of shells in one B-Rep body (see prc_api_get_number_brep_
+ * bodies for the body_index space).
+ *
+ * @param ctx Active API context.
+ * @param data_in Data handle from prc_api_open_contents.
+ * @param body_index B-Rep body index (0 <= body_index < prc_api_get_number_brep_bodies()).
+ * @return Number of shells, or 0 for an out-of-range body_index.
+ */
+PRC_EXPORT uint32_t prc_api_get_number_brep_shells(prc_context *ctx, prc_api_data data_in,
+    uint32_t body_index);
+
+/**
+ * @brief Number of faces in one shell of one B-Rep body.
+ *
+ * @param ctx Active API context.
+ * @param data_in Data handle from prc_api_open_contents.
+ * @param body_index B-Rep body index.
+ * @param shell_index Shell index in the body (0 <= shell_index < prc_api_get_number_brep_shells()).
+ * @return Number of faces, or 0 for an out-of-range body_index/shell_index.
+ */
+PRC_EXPORT uint32_t prc_api_get_number_brep_faces(prc_context *ctx, prc_api_data data_in,
+    uint32_t body_index, uint32_t shell_index);
+
+/**
+ * @brief Report which exact-geometry surface type one face carries, for a
+ * (body_index, shell_index, face_index) triple addressed through
+ * prc_api_get_number_brep_bodies/_shells/_faces above.
+ *
+ * SCOPE, IMPORTANT: only recognizes faces reached through PRC's
+ * *uncompressed* B-Rep body encoding (PRC_TYPE_TOPO_BrepData) belonging to
+ * a body with exactly one connex, whose connex/shell/face chain is stored
+ * inline rather than referenced (matches the restriction nanoPRC's own
+ * exact-geometry tessellator applies in prc_approximate_objects_exact_geom
+ * before it will even attempt to tessellate a BrepData body -- see that
+ * function's "single_connex"/is_stored checks in
+ * src/prc_tessellation_exact_geom.c). Bodies that fail that restriction,
+ * or use PRC's *compressed* B-Rep encoding (PRC_TYPE_TOPO_BrepDataCompress)
+ * -- which most real-world CAD-authored 3D PDFs use, and which
+ * reconstructs each face's geometry through a bespoke, face-type-specific
+ * synthesis process this function does not decode -- are excluded from
+ * the body_index space entirely (see prc_api_get_number_brep_bodies), so
+ * within a valid body_index every face is guaranteed to have a real
+ * surface; PRC_API_SURFACE_UNKNOWN here means only "this face's surface
+ * type isn't one of the (currently one) types this API decodes" -- e.g. a
+ * plane, cylinder, or any analytic type other than NURBS. That is a real,
+ * known, and currently permanent limitation of this API, not a bug to
+ * work around by retrying.
+ *
+ * @param ctx Active API context.
+ * @param data_in Data handle from prc_api_open_contents.
+ * @param body_index B-Rep body index.
+ * @param shell_index Shell index in the body.
+ * @param face_index Face index in the shell.
+ * @param out_type Output surface type.
+ * @return 0 on success (including the UNKNOWN case -- that is a normal
+ *         result, not a failure), negative PRC_API_ERROR_* or PRC_ERROR_*
+ *         code only for an out-of-range index or a malformed file.
+ */
+PRC_EXPORT int prc_api_get_face_surface_type(prc_context *ctx, prc_api_data data_in,
+    uint32_t body_index, uint32_t shell_index, uint32_t face_index,
+    prc_api_surface_type *out_type);
+
+/**
+ * @brief One NURBS surface's full mathematical representation: degree,
+ * control points (with weights, for the rational case), and knot vectors
+ * in both parametric directions -- everything prc_evaluate_surf_nurbs
+ * (src/prc_tessellation_exact_geom.c), nanoPRC's own internal NURBS
+ * evaluator, needs to compute a point on the surface, exposed for a
+ * caller to do the same thing outside this library (measurement, export
+ * to another representation, etc).
+ *
+ * This is the UNTRIMMED surface: a full rectangular NURBS patch over its
+ * declared knot domain, not clipped to the owning face's actual visible
+ * boundary. PRC's trim-loop data (the curves that bound a face within
+ * its surface) is not exposed by this API.
+ *
+ * Control points are stored flattened u-major -- index = u_index *
+ * num_control_points_v + v_index, so v varies fastest within each fixed
+ * u -- length num_control_points_u * num_control_points_v. This matches
+ * prc_evaluate_surf_nurbs's own indexing (see that function's comment in
+ * src/prc_tessellation_exact_geom.c) exactly; do not transpose it.
+ * control_w is only meaningful when is_rational is nonzero; nanoPRC still
+ * populates it (as 1.0 per point) in the non-rational case, so it is
+ * always safe to
+ * read.
+ */
+typedef struct prc_api_nurbs_surface_s
+{
+    uint8_t is_rational;
+    uint32_t degree_u;
+    uint32_t degree_v;
+    uint32_t num_control_points_u;
+    uint32_t num_control_points_v;
+    double *control_x;
+    double *control_y;
+    double *control_z;
+    double *control_w;
+    uint32_t num_knots_u;
+    double *knot_vector_u;
+    uint32_t num_knots_v;
+    double *knot_vector_v;
+} prc_api_nurbs_surface;
+
+/**
+ * @brief For a face whose prc_api_get_face_surface_type reports
+ * PRC_API_SURFACE_NURBS, copy out its full control-point/knot-vector/
+ * degree representation. Same (body_index, shell_index, face_index)
+ * addressing and the same SCOPE restriction as prc_api_get_face_surface_
+ * type -- call that first and check for PRC_API_SURFACE_NURBS; this
+ * function returns PRC_API_ERROR_PARAMETER for a face of any other type
+ * (including UNKNOWN), rather than silently populating nonsense.
+ *
+ * @param ctx Active API context.
+ * @param data_in Data handle from prc_api_open_contents.
+ * @param body_index B-Rep body index.
+ * @param shell_index Shell index in the body.
+ * @param face_index Face index in the shell.
+ * @param out_surface Output surface data; caller must release with
+ *                     prc_api_release_nurbs_surface.
+ * @return 0 on success, negative PRC_API_ERROR_* or PRC_ERROR_* code on
+ *         failure (including "this face isn't NURBS").
+ */
+PRC_EXPORT int prc_api_get_face_nurbs_surface(prc_context *ctx, prc_api_data data_in,
+    uint32_t body_index, uint32_t shell_index, uint32_t face_index,
+    prc_api_nurbs_surface *out_surface);
+
+/**
+ * @brief Free the control-point/knot-vector arrays populated by
+ * prc_api_get_face_nurbs_surface. Safe to call on a zero-initialized or
+ * already-released prc_api_nurbs_surface (all fields NULL).
+ *
+ * @param ctx Active API context.
+ * @param surface Surface data to release.
+ */
+PRC_EXPORT void prc_api_release_nurbs_surface(prc_context *ctx, prc_api_nurbs_surface *surface);
+
 /**
  * @brief Get one graphics primitive descriptor by index.
  *
diff --git a/src/prc_tri_primitives_api.c b/src/prc_tri_primitives_api.c
index 60fb79b..bc6a8ba 100644
--- a/src/prc_tri_primitives_api.c
+++ b/src/prc_tri_primitives_api.c
@@ -3442,6 +3442,337 @@ failure:
     return code;
 }
 
+/* Whether a body is addressable through the prc_api_get_number_brep_bodies
+   index space: PRC_TYPE_TOPO_BrepData, exactly one connex, stored inline.
+   Same restriction prc_approximate_objects_exact_geom (src/prc_tessellation_
+   exact_geom.c) applies before it will tessellate a BrepData body. */
+static int
+prc_api_helper_body_is_indexable_brep(prc_topo *body_topo)
+{
+    prc_topo_brep_data *brep_data;
+
+    if (body_topo->tag != PRC_TYPE_TOPO_BrepData)
+        return 0; /* Most commonly PRC_TYPE_TOPO_BrepDataCompress -- see doc comment. */
+
+    brep_data = body_topo->topo_brep_data;
+    if (brep_data->number_of_connex != 1)
+        return 0;
+
+    if (brep_data->connex[0].is_stored)
+        return 0;
+
+    return 1;
+}
+
+/* Shared navigation for prc_api_get_number_brep_shells/_faces and
+   prc_api_get_face_surface_type/_nurbs_surface: walks file_struct ->
+   exact_geometry -> topo_contexts -> bodies in order, deliberately
+   independent of data->exact_geom_tess_part (that array is only populated
+   as a side effect of prc_api_prep_model_tree, and only for representation
+   items that have NO regular tessellation of their own -- see the SCOPE
+   note on prc_api_get_number_brep_bodies in prc_api.h for why indexing
+   through it made this API a no-op on real-world files). Returns NULL
+   (not an error) for a body_index that is in range of "bodies that exist"
+   but not of "bodies this API indexes" -- that can't happen for a
+   body_index that came from prc_api_get_number_brep_bodies itself, but
+   this is also reachable directly, so the guard stays. Sets *out_code
+   negative only for an actual out-of-range index. */
+static prc_topo *
+prc_api_helper_locate_brep_body(prc_context *ctx, prc_data *data,
+    uint32_t body_index, int *out_code)
+{
+    uint32_t i, j, k, seen = 0;
+
+    *out_code = 0;
+
+    for (i = 0; i < data->file_structure_count; i++)
+    {
+        uint32_t topo_context_count;
+
+        if (data->file_struct[i].geometry == NULL)
+            continue;
+
+        topo_context_count = data->file_struct[i].geometry->exact_geometry.topo_context_count;
+        for (j = 0; j < topo_context_count; j++)
+        {
+            prc_topo_context *tc = &data->file_struct[i].geometry->exact_geometry.topo_contexts[j];
+
+            for (k = 0; k < tc->number_of_bodies; k++)
+            {
+                if (!prc_api_helper_body_is_indexable_brep(&tc->bodies[k]))
+                    continue;
+
+                if (seen == body_index)
+                    return &tc->bodies[k];
+
+                seen++;
+            }
+        }
+    }
+
+    prc_error(ctx, PRC_API_ERROR_PARAMETER,
+        "B-Rep body index out of range in prc_api_helper_locate_brep_body\n");
+    *out_code = PRC_API_ERROR_PARAMETER;
+    return NULL;
+}
+
+PRC_EXPORT uint32_t
+prc_api_get_number_brep_bodies(prc_context *ctx, prc_api_data data_in)
+{
+    prc_data *data = (prc_data *)data_in;
+    uint32_t i, j, k, count = 0;
+
+    if (data == NULL)
+        return 0;
+
+    for (i = 0; i < data->file_structure_count; i++)
+    {
+        uint32_t topo_context_count;
+
+        if (data->file_struct[i].geometry == NULL)
+            continue;
+
+        topo_context_count = data->file_struct[i].geometry->exact_geometry.topo_context_count;
+        for (j = 0; j < topo_context_count; j++)
+        {
+            prc_topo_context *tc = &data->file_struct[i].geometry->exact_geometry.topo_contexts[j];
+
+            for (k = 0; k < tc->number_of_bodies; k++)
+            {
+                if (prc_api_helper_body_is_indexable_brep(&tc->bodies[k]))
+                    count++;
+            }
+        }
+    }
+
+    return count;
+}
+
+PRC_EXPORT uint32_t
+prc_api_get_number_brep_shells(prc_context *ctx, prc_api_data data_in, uint32_t body_index)
+{
+    prc_data *data = (prc_data *)data_in;
+    prc_topo *body_topo;
+    int code = 0;
+
+    body_topo = prc_api_helper_locate_brep_body(ctx, data, body_index, &code);
+    if (body_topo == NULL)
+        return 0;
+
+    return body_topo->topo_brep_data->connex[0].topo->topo_connex->number_of_shells;
+}
+
+PRC_EXPORT uint32_t
+prc_api_get_number_brep_faces(prc_context *ctx, prc_api_data data_in,
+    uint32_t body_index, uint32_t shell_index)
+{
+    prc_data *data = (prc_data *)data_in;
+    prc_topo *body_topo;
+    prc_topo_connex *connex;
+    prc_ptr_topology *shell_ptr;
+    int code = 0;
+
+    body_topo = prc_api_helper_locate_brep_body(ctx, data, body_index, &code);
+    if (body_topo == NULL)
+        return 0;
+
+    connex = body_topo->topo_brep_data->connex[0].topo->topo_connex;
+    if (shell_index >= connex->number_of_shells)
+    {
+        prc_error(ctx, PRC_API_ERROR_PARAMETER,
+            "Shell index out of range in prc_api_get_number_brep_faces\n");
+        return 0;
+    }
+
+    shell_ptr = &connex->shells[shell_index];
+    if (shell_ptr->is_stored)
+        return 0; /* Referenced rather than inline -- outside this API's scope. */
+
+    return shell_ptr->topo->topo_shell->number_of_faces;
+}
+
+/* Shared navigation for prc_api_get_face_surface_type and
+   prc_api_get_face_nurbs_surface: walks from a (body_index, shell_index,
+   face_index) triple down to the prc_topo_face carrying that face's
+   surface. Returns NULL (not an error) for a shell/face link that is
+   referenced rather than stored inline -- outside this API's scope, see
+   the SCOPE note on prc_api_get_face_surface_type in prc_api.h. Returns
+   NULL and sets *out_code negative only for an actual out-of-range
+   index. */
+static prc_topo_face *
+prc_api_helper_get_topo_face_for_brep_body(prc_context *ctx, prc_data *data,
+    uint32_t body_index, uint32_t shell_index, uint32_t face_index,
+    int *out_code)
+{
+    prc_topo *body_topo;
+    prc_topo_connex *connex;
+    prc_ptr_topology *shell_ptr;
+    prc_topo_shell *shell;
+    prc_ptr_topology *face_ptr;
+
+    body_topo = prc_api_helper_locate_brep_body(ctx, data, body_index, out_code);
+    if (body_topo == NULL)
+        return NULL;
+
+    connex = body_topo->topo_brep_data->connex[0].topo->topo_connex;
+
+    if (shell_index >= connex->number_of_shells)
+    {
+        prc_error(ctx, PRC_API_ERROR_PARAMETER,
+            "Shell index out of range in prc_api_helper_get_topo_face_for_brep_body\n");
+        *out_code = PRC_API_ERROR_PARAMETER;
+        return NULL;
+    }
+
+    shell_ptr = &connex->shells[shell_index];
+    if (shell_ptr->is_stored)
+        return NULL;
+    shell = shell_ptr->topo->topo_shell;
+
+    if (face_index >= shell->number_of_faces)
+    {
+        prc_error(ctx, PRC_API_ERROR_PARAMETER,
+            "Face index out of range in prc_api_helper_get_topo_face_for_brep_body\n");
+        *out_code = PRC_API_ERROR_PARAMETER;
+        return NULL;
+    }
+
+    face_ptr = &shell->faces[face_index].face;
+    if (face_ptr->is_stored)
+        return NULL;
+
+    return face_ptr->topo->topo_face;
+}
+
+PRC_EXPORT int
+prc_api_get_face_surface_type(prc_context *ctx, prc_api_data data_in,
+    uint32_t body_index, uint32_t shell_index, uint32_t face_index,
+    prc_api_surface_type *out_type)
+{
+    prc_data *data = (prc_data *)data_in;
+    prc_topo_face *topo_face;
+    int code = 0;
+
+    if (out_type == NULL)
+    {
+        prc_error(ctx, PRC_API_ERROR_PARAMETER, "out_type is NULL in prc_api_get_face_surface_type\n");
+        return PRC_API_ERROR_PARAMETER;
+    }
+    *out_type = PRC_API_SURFACE_UNKNOWN;
+
+    topo_face = prc_api_helper_get_topo_face_for_brep_body(ctx, data,
+        body_index, shell_index, face_index, &code);
+    if (code < 0)
+        return code;
+    if (topo_face == NULL)
+        return 0; /* In scope for the index range, just not a recognized case -- UNKNOWN, not an error. */
+
+    if (topo_face->surface_geometry.surface.surface_type == PRC_TYPE_SURF_NURBS)
+        *out_type = PRC_API_SURFACE_NURBS;
+
+    return 0;
+}
+
+PRC_EXPORT int
+prc_api_get_face_nurbs_surface(prc_context *ctx, prc_api_data data_in,
+    uint32_t body_index, uint32_t shell_index, uint32_t face_index,
+    prc_api_nurbs_surface *out_surface)
+{
+    prc_data *data = (prc_data *)data_in;
+    prc_topo_face *topo_face;
+    prc_surf_nurbs *nurbs;
+    uint32_t num_cp, num_ku, num_kv, i;
+    int code = 0;
+
+    if (out_surface == NULL)
+    {
+        prc_error(ctx, PRC_API_ERROR_PARAMETER, "out_surface is NULL in prc_api_get_face_nurbs_surface\n");
+        return PRC_API_ERROR_PARAMETER;
+    }
+    memset(out_surface, 0, sizeof(*out_surface));
+
+    topo_face = prc_api_helper_get_topo_face_for_brep_body(ctx, data,
+        body_index, shell_index, face_index, &code);
+    if (code < 0)
+        return code;
+    if (topo_face == NULL || topo_face->surface_geometry.surface.surface_type != PRC_TYPE_SURF_NURBS)
+    {
+        prc_error(ctx, PRC_API_ERROR_PARAMETER,
+            "Face is not a NURBS surface (call prc_api_get_face_surface_type first) in prc_api_get_face_nurbs_surface\n");
+        return PRC_API_ERROR_PARAMETER;
+    }
+
+    nurbs = topo_face->surface_geometry.surface.surf_nurbs;
+
+    out_surface->is_rational = nurbs->is_rational;
+    out_surface->degree_u = nurbs->du;
+    out_surface->degree_v = nurbs->dv;
+    out_surface->num_control_points_u = nurbs->highest_index_of_control_points_u + 1;
+    out_surface->num_control_points_v = nurbs->highest_index_of_control_points_v + 1;
+    out_surface->num_knots_u = nurbs->highest_index_of_knots_u + 1;
+    out_surface->num_knots_v = nurbs->highest_index_of_knots_v + 1;
+
+    num_cp = out_surface->num_control_points_u * out_surface->num_control_points_v;
+    num_ku = out_surface->num_knots_u;
+    num_kv = out_surface->num_knots_v;
+
+    out_surface->control_x = (double *)prc_calloc(ctx, num_cp ? num_cp : 1, sizeof(double));
+    out_surface->control_y = (double *)prc_calloc(ctx, num_cp ? num_cp : 1, sizeof(double));
+    out_surface->control_z = (double *)prc_calloc(ctx, num_cp ? num_cp : 1, sizeof(double));
+    out_surface->control_w = (double *)prc_calloc(ctx, num_cp ? num_cp : 1, sizeof(double));
+    out_surface->knot_vector_u = (double *)prc_calloc(ctx, num_ku ? num_ku : 1, sizeof(double));
+    out_surface->knot_vector_v = (double *)prc_calloc(ctx, num_kv ? num_kv : 1, sizeof(double));
+    if (out_surface->control_x == NULL || out_surface->control_y == NULL ||
+        out_surface->control_z == NULL || out_surface->control_w == NULL ||
+        out_surface->knot_vector_u == NULL || out_surface->knot_vector_v == NULL)
+    {
+        prc_api_release_nurbs_surface(ctx, out_surface);
+        prc_error(ctx, PRC_ERROR_MEMORY, "Allocation error in prc_api_get_face_nurbs_surface\n");
+        return PRC_ERROR_MEMORY;
+    }
+
+    for (i = 0; i < num_cp; i++)
+    {
+        out_surface->control_x[i] = nurbs->p[i].x;
+        out_surface->control_y[i] = nurbs->p[i].y;
+        out_surface->control_z[i] = nurbs->p[i].z;
+        /* nurbs->p[i].w is only meaningful when is_rational; nanoPRC's
+           parser leaves it at its calloc'd 0.0 otherwise, which would
+           silently zero every non-rational control point under a
+           homogeneous-coordinate evaluator (x,y,z,w) -- normalize to 1.0
+           here so the output is always safe to treat as w-meaningful. */
+        out_surface->control_w[i] = nurbs->is_rational ? nurbs->p[i].w : 1.0;
+    }
+    for (i = 0; i < num_ku; i++)
+        out_surface->knot_vector_u[i] = nurbs->knot_vector_u[i];
+    for (i = 0; i < num_kv; i++)
+        out_surface->knot_vector_v[i] = nurbs->knot_vector_v[i];
+
+    return 0;
+}
+
+PRC_EXPORT void
+prc_api_release_nurbs_surface(prc_context *ctx, prc_api_nurbs_surface *surface)
+{
+    if (surface == NULL)
+        return;
+
+    if (surface->control_x != NULL)
+        prc_free(ctx, surface->control_x);
+    if (surface->control_y != NULL)
+        prc_free(ctx, surface->control_y);
+    if (surface->control_z != NULL)
+        prc_free(ctx, surface->control_z);
+    if (surface->control_w != NULL)
+        prc_free(ctx, surface->control_w);
+    if (surface->knot_vector_u != NULL)
+        prc_free(ctx, surface->knot_vector_u);
+    if (surface->knot_vector_v != NULL)
+        prc_free(ctx, surface->knot_vector_v);
+
+    memset(surface, 0, sizeof(*surface));
+}
+
 /* tess_index_in is an index into the tessellations in part_details or
    markup_details in prc_data */
 PRC_EXPORT int
