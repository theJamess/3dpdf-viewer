diff --git a/tests/internal/check_nurbs_surface_api.c b/tests/internal/check_nurbs_surface_api.c
new file mode 100644
index 0000000..8bff91b
--- /dev/null
+++ b/tests/internal/check_nurbs_surface_api.c
@@ -0,0 +1,250 @@
+/* Copyright (C) 2023-2026 CascadiaVoxel LLC
+
+    nanoPRC is free software: you can redistribute it and/or modify it under
+    the terms of the GNU Affero General Public License as published by the
+    Free Software Foundation, either version 3 of the License, or (at your
+    option) any later version.
+
+    nanoPRC is distributed in the hope that it will be useful, but WITHOUT
+    ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+    FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public
+    License for more details.
+
+    You should have received a copy of the GNU Affero General Public License
+    along with nanoPRC. If not, see <https://www.gnu.org/licenses/>.
+*/
+
+/* INTERNAL DEVELOPMENT TOOL -- not part of the permanent test suite, not
+   registered with CTest, no exit-code contract to keep stable.
+
+   WHAT: Exercises the new prc_api_get_face_surface_type / prc_api_get_face_
+   nurbs_surface API (uncompressed BrepData NURBS exposure) end to end and
+   cross-validates the returned control points/knots/degree independently
+   of nanoPRC's own tessellator: it evaluates the surface itself (a
+   from-scratch Cox-de Boor implementation written in THIS file, sharing no
+   code with prc_evaluate_surf_nurbs in prc_tessellation_exact_geom.c)
+   across a grid of (u,v) and checks the resulting points lie at a constant
+   radius from the Z axis -- the defining property of a cylinder, which is
+   what cylinder.pdf actually contains, so a bug in either the extraction
+   (wrong control points/knots/degree) or a transposed u/v would show up as
+   a non-constant radius or NaNs, not just "some numbers came out".
+
+   usage: check_nurbs_surface_api <cylinder.pdf> [expected_radius] [tol] */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "prc_api.h"
+
+static double
+basis_function(uint32_t i, uint32_t degree, double t, const double *knots, uint32_t num_knots)
+{
+    double left, right, c1, c2;
+
+    if (degree == 0)
+    {
+        if (knots[i] <= t && (t < knots[i + 1] || (t == knots[i + 1] && i + 2 == num_knots)))
+            return 1.0;
+        return 0.0;
+    }
+
+    c1 = c2 = 0.0;
+    left = knots[i + degree] - knots[i];
+    if (left > 1e-12)
+        c1 = (t - knots[i]) / left * basis_function(i, degree - 1, t, knots, num_knots);
+
+    right = knots[i + degree + 1] - knots[i + 1];
+    if (right > 1e-12)
+        c2 = (knots[i + degree + 1] - t) / right * basis_function(i + 1, degree - 1, t, knots, num_knots);
+
+    return c1 + c2;
+}
+
+static void
+evaluate_nurbs(const prc_api_nurbs_surface *s, double u, double v, double out[3])
+{
+    double num[3] = { 0, 0, 0 }, den = 0.0;
+    uint32_t iu, iv;
+
+    for (iu = 0; iu < s->num_control_points_u; iu++)
+    {
+        double bu = basis_function(iu, s->degree_u, u, s->knot_vector_u, s->num_knots_u);
+        if (bu == 0.0) continue;
+        for (iv = 0; iv < s->num_control_points_v; iv++)
+        {
+            double bv = basis_function(iv, s->degree_v, v, s->knot_vector_v, s->num_knots_v);
+            double b = bu * bv;
+            uint32_t idx;
+            double w;
+            if (b == 0.0) continue;
+            idx = iu * s->num_control_points_v + iv;
+            w = s->control_w[idx] * b;
+            num[0] += w * s->control_x[idx];
+            num[1] += w * s->control_y[idx];
+            num[2] += w * s->control_z[idx];
+            den += w;
+        }
+    }
+
+    if (den > 1e-12)
+    {
+        out[0] = num[0] / den;
+        out[1] = num[1] / den;
+        out[2] = num[2] / den;
+    }
+    else
+    {
+        out[0] = out[1] = out[2] = NAN;
+    }
+}
+
+int main(int argc, char **argv)
+{
+    prc_context *ctx;
+    prc_api_data data;
+    uint32_t num_exact_objects, obj, s, f;
+    double expected_radius = -1.0;
+    double tol = 0.05;
+    int found_nurbs = 0;
+    int bad = 0;
+
+    if (argc < 2)
+    {
+        printf("usage: %s <file.pdf> [expected_radius] [tol=0.05]\n", argv[0]);
+        return 2;
+    }
+    if (argc >= 3) expected_radius = atof(argv[2]);
+    if (argc >= 4) tol = atof(argv[3]);
+
+    ctx = prc_api_new_context(NULL);
+    if (ctx == NULL) { printf("context creation failed\n"); return 1; }
+
+    data = prc_api_open_contents(ctx, argv[1]);
+    if (data == NULL) { printf("prc_api_open_contents failed\n"); prc_api_print_error_stack(ctx); return 1; }
+
+    num_exact_objects = prc_api_get_number_brep_bodies(ctx, data);
+    printf("num_brep_bodies=%u\n", num_exact_objects);
+
+    for (obj = 0; obj < num_exact_objects; obj++)
+    {
+        uint32_t num_shells = prc_api_get_number_brep_shells(ctx, data, obj);
+        for (s = 0; s < num_shells; s++)
+        {
+            uint32_t num_faces = prc_api_get_number_brep_faces(ctx, data, obj, s);
+            for (f = 0; f < num_faces; f++)
+            {
+                prc_api_surface_type type = PRC_API_SURFACE_UNKNOWN;
+                int code = prc_api_get_face_surface_type(ctx, data, obj, s, f, &type);
+                if (code < 0)
+                {
+                    printf("obj=%u shell=%u face=%u: get_face_surface_type failed (%d)\n", obj, s, f, code);
+                    bad++;
+                    continue;
+                }
+                printf("obj=%u shell=%u face=%u surface_type=%d\n", obj, s, f, (int)type);
+                if (type != PRC_API_SURFACE_NURBS)
+                    continue;
+
+                {
+                    prc_api_nurbs_surface surf;
+                    uint32_t gu, gv, n_samples = 9;
+                    double min_r = 1e300, max_r = -1e300, min_z = 1e300, max_z = -1e300;
+                    int nan_count = 0;
+
+                    code = prc_api_get_face_nurbs_surface(ctx, data, obj, s, f, &surf);
+                    if (code < 0)
+                    {
+                        printf("  get_face_nurbs_surface failed (%d)\n", code);
+                        bad++;
+                        continue;
+                    }
+                    found_nurbs = 1;
+                    printf("  is_rational=%u degree_u=%u degree_v=%u cp=%ux%u knots=%u/%u\n",
+                        surf.is_rational, surf.degree_u, surf.degree_v,
+                        surf.num_control_points_u, surf.num_control_points_v,
+                        surf.num_knots_u, surf.num_knots_v);
+
+                    if (surf.num_knots_u != surf.num_control_points_u + surf.degree_u + 1 ||
+                        surf.num_knots_v != surf.num_control_points_v + surf.degree_v + 1)
+                    {
+                        printf("  BAD knot-count/degree/control-point relationship (m = n + p + 1 violated)\n");
+                        bad++;
+                    }
+
+                    for (gu = 0; gu < n_samples; gu++)
+                    {
+                        double u = surf.knot_vector_u[surf.degree_u] +
+                            (surf.knot_vector_u[surf.num_knots_u - 1 - surf.degree_u] - surf.knot_vector_u[surf.degree_u]) *
+                            ((double)gu / (n_samples - 1));
+                        for (gv = 0; gv < n_samples; gv++)
+                        {
+                            double v = surf.knot_vector_v[surf.degree_v] +
+                                (surf.knot_vector_v[surf.num_knots_v - 1 - surf.degree_v] - surf.knot_vector_v[surf.degree_v]) *
+                                ((double)gv / (n_samples - 1));
+                            double p[3];
+                            double r;
+
+                            /* Clamp the very last sample onto the closed knot span exactly,
+                               since basis_function's half-open convention can drop the upper
+                               boundary to 0 due to floating point. */
+                            if (gu == n_samples - 1) u = surf.knot_vector_u[surf.num_knots_u - 1 - surf.degree_u];
+                            if (gv == n_samples - 1) v = surf.knot_vector_v[surf.num_knots_v - 1 - surf.degree_v];
+
+                            evaluate_nurbs(&surf, u, v, p);
+                            if (isnan(p[0]) || isnan(p[1]) || isnan(p[2]))
+                            {
+                                nan_count++;
+                                continue;
+                            }
+                            r = sqrt(p[0] * p[0] + p[1] * p[1]);
+                            if (r < min_r) min_r = r;
+                            if (r > max_r) max_r = r;
+                            if (p[2] < min_z) min_z = p[2];
+                            if (p[2] > max_z) max_z = p[2];
+                        }
+                    }
+
+                    printf("  sampled radius range [%.6f, %.6f] (spread=%.6f) z range [%.6f, %.6f] nan_count=%d\n",
+                        min_r, max_r, max_r - min_r, min_z, max_z, nan_count);
+
+                    if (nan_count > 0)
+                    {
+                        printf("  BAD: %d NaN samples\n", nan_count);
+                        bad++;
+                    }
+                    else if (max_r - min_r > tol)
+                    {
+                        printf("  BAD: radius not constant within tol=%.6f (this file should be a cylinder)\n", tol);
+                        bad++;
+                    }
+                    else if (expected_radius > 0 && fabs((min_r + max_r) / 2.0 - expected_radius) > tol)
+                    {
+                        printf("  BAD: radius %.6f does not match expected %.6f (tol=%.6f)\n",
+                            (min_r + max_r) / 2.0, expected_radius, tol);
+                        bad++;
+                    }
+                    else
+                    {
+                        printf("  OK: radius is constant, consistent with a cylindrical NURBS surface\n");
+                    }
+
+                    prc_api_release_nurbs_surface(ctx, &surf);
+                }
+            }
+        }
+    }
+
+    if (!found_nurbs)
+    {
+        printf("no NURBS faces found -- nothing was cross-validated\n");
+        prc_api_release_data(ctx, data, NULL, 0, NULL, 0, NULL, 0, NULL);
+        prc_api_release_context(ctx);
+        return 1;
+    }
+
+    printf(bad == 0 ? "RESULT: PASS\n" : "RESULT: FAIL (%d problem(s))\n", bad);
+    prc_api_release_data(ctx, data, NULL, 0, NULL, 0, NULL, 0, NULL);
+    prc_api_release_context(ctx);
+    return bad == 0 ? 0 : 1;
+}
