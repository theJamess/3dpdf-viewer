+    License for more details.
+
+    You should have received a copy of the GNU Affero General Public License
+    along with nanoPRC. If not, see <https://www.gnu.org/licenses/>.
+*/
+
+/* INTERNAL DEVELOPMENT TOOL -- not part of the permanent test suite, not
+   registered with CTest, no exit-code contract to keep stable.
+
+   WHAT: Unit-tests prc_api_get_number_brep_bodies/_shells/_faces and
+   prc_api_get_face_surface_type/prc_api_get_face_nurbs_surface WITHOUT a
+   real PDF. It hand-builds a minimal in-memory prc_data -- one file
+   structure, one TopoContext, one BrepData body with one connex, one
+   shell, two faces (a non-rational bilinear NURBS patch and a rational
+   one) -- and calls the public API directly against it.
+
+   WHY: no available sample 3D PDF (see tests/internal/brep_entity_census)
+   carries an uncompressed-BrepData face whose surface is actually NURBS --
+   cylinder.pdf's one usable BrepData face is an analytic Cylinder surface
+   (confirmed by this file's own check_nurbs_surface_api.c run and cross-
+   checked against brep_entity_census), and nanoPRC's writer has no support
+   for authoring exact B-Rep geometry at all, so a synthetic test PDF isn't
+   an option either. What check_nurbs_surface_api.c against real files DOES
+   establish -- the body/shell/face walk and the "not NURBS reports
+   UNKNOWN" path -- is real and file-backed; this tool covers the part that
+   isn't: the actual control-point/knot-vector/degree copy, including the
+   non-rational weight-normalization behavior, verified against exactly
+   known input rather than an unknown real file's data.
+
+   HOW: constructs the object graph directly (no parser, no file I/O),
+   matching the exact struct layouts prc_parse_extra_geometry.c and
+   prc_tessellation_exact_geom.c produce/consume, then:
+     1. Checks prc_api_get_number_brep_bodies/_shells/_faces report exactly
+        1/1/2.
+     2. Checks prc_api_get_face_surface_type reports NURBS for both faces.
+     3. Checks prc_api_get_face_nurbs_surface returns exactly the fed-in
+        degree/control-points/knots for both faces, byte-for-byte -- and
+        for the non-rational face, that control_w reads back as 1.0 despite
+        the input weight field being 0.0 (the documented normalization).
+     4. Independently evaluates both patches with a from-scratch bilinear
+        interpolation (NOT a NURBS evaluator, deliberately -- degree-1
+        Cox-de Boor over a 2-knot-span clamped vector reduces exactly to
+        bilinear/rational-bilinear interpolation, so comparing against that
+        closed form is a second, unrelated way to state the expected
+        answer) at several (u,v) and checks the returned control points,
+        when applied through that formula, reproduce the corner points and
+        an interior point exactly (non-rational) or within floating-point
+        tolerance (rational, where the weights are not all equal).
+
+   LIMITATIONS: does not exercise the PRC parser (prc_parse_surf_nurbs) or
+   file/PDF extraction at all -- that machinery is pre-existing nanoPRC
+   code this project did not write or modify, and was separately confirmed
+   present and structurally sound during this feature's design (see
+   src/prc_parse_extra_geometry.c). This tool is scoped to the NEW code:
+   the body/shell/face indexing and the struct-to-public-API copy. */
+
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+#include "prc_api.h"
+#include "prc_context.h"
+#include "prc_data.h"
+
+static int g_bad = 0;
+
+#define CHECK(cond, msg) \
+    do { if (!(cond)) { printf("FAIL: %s\n", msg); g_bad++; } } while (0)
+
+/* Rational bilinear interpolation over the 4 corners of a degree-1x1
+   clamped NURBS patch -- the closed-form answer a 2x2-control-point NURBS
+   surface must produce at (u,v) in [0,1]x[0,1], independent of and not
+   derived from prc_evaluate_surf_nurbs. p00,p01,p10,p11 index by
+   (u_index,v_index); w* are their weights (1.0 for the non-rational case). */
+static void
+bilinear(double u, double v,
+    const double p00[3], double w00, const double p01[3], double w01,
+    const double p10[3], double w10, const double p11[3], double w11,
+    double out[3])
+{
+    double b00 = (1 - u) * (1 - v) * w00;
+    double b01 = (1 - u) * v * w01;
+    double b10 = u * (1 - v) * w10;
+    double b11 = u * v * w11;
+    double wsum = b00 + b01 + b10 + b11;
+    int k;
+    for (k = 0; k < 3; k++)
+        out[k] = (b00 * p00[k] + b01 * p01[k] + b10 * p10[k] + b11 * p11[k]) / wsum;
+}
+
+int main(void)
+{
+    prc_context *ctx;
+    prc_data data;
+    prc_filestructure fs;
+    prc_asm_file_structure_geometry geom;
+    prc_topo_context tc;
+    prc_topo body;
+    prc_topo_brep_data brep_data;
+    prc_ptr_topology connex_ptr;
+    prc_topo connex_topo;
+    prc_topo_connex connex;
+    prc_ptr_topology shell_ptr;
+    prc_topo shell_topo;
+    prc_topo_shell shell;
+    prc_faces_in_shell face_slots[2];
+    prc_topo face_topos[2];
+    prc_topo_face faces[2];
+    prc_surf_nurbs nurbs_nonrational, nurbs_rational;
+    prc_control_points_nurbs_surf cp_nonrational[4];
+    prc_control_points_nurbs_surf cp_rational[4];
+    double knots_u[4] = { 0.0, 0.0, 1.0, 1.0 };
+    double knots_v[4] = { 0.0, 0.0, 1.0, 1.0 };
+    uint32_t n_bodies, n_shells, n_faces;
+    int code;
+
+    ctx = prc_api_new_context(NULL);
+    if (ctx == NULL) { printf("context creation failed\n"); return 1; }
+
+    memset(&data, 0, sizeof(data));
+    memset(&fs, 0, sizeof(fs));
+    memset(&geom, 0, sizeof(geom));
+    memset(&tc, 0, sizeof(tc));
+    memset(&body, 0, sizeof(body));
+    memset(&brep_data, 0, sizeof(brep_data));
+    memset(&connex_ptr, 0, sizeof(connex_ptr));
+    memset(&connex_topo, 0, sizeof(connex_topo));
+    memset(&connex, 0, sizeof(connex));
+    memset(&shell_ptr, 0, sizeof(shell_ptr));
+    memset(&shell_topo, 0, sizeof(shell_topo));
+    memset(&shell, 0, sizeof(shell));
+    memset(face_slots, 0, sizeof(face_slots));
+    memset(face_topos, 0, sizeof(face_topos));
+    memset(faces, 0, sizeof(faces));
+    memset(&nurbs_nonrational, 0, sizeof(nurbs_nonrational));
+    memset(&nurbs_rational, 0, sizeof(nurbs_rational));
+
+    /* Face 0: non-rational twisted bilinear patch. Index order matches
+       prc_evaluate_surf_nurbs's documented "u-major: ctrl_u*num_ctrl_v+ctrl_v". */
+    cp_nonrational[0] = (prc_control_points_nurbs_surf){ 0.0, 0.0, 0.0, 0.0 }; /* u=0,v=0 */
+    cp_nonrational[1] = (prc_control_points_nurbs_surf){ 0.0, 1.0, 2.0, 0.0 }; /* u=0,v=1 */
+    cp_nonrational[2] = (prc_control_points_nurbs_surf){ 1.0, 0.0, 5.0, 0.0 }; /* u=1,v=0 */
+    cp_nonrational[3] = (prc_control_points_nurbs_surf){ 1.0, 1.0, -3.0, 0.0 }; /* u=1,v=1 */
+
+    nurbs_nonrational.tag = PRC_TYPE_SURF_NURBS;
+    nurbs_nonrational.is_rational = 0;
+    nurbs_nonrational.du = 1;
+    nurbs_nonrational.dv = 1;
+    nurbs_nonrational.highest_index_of_control_points_u = 1;
+    nurbs_nonrational.highest_index_of_control_points_v = 1;
+    nurbs_nonrational.highest_index_of_knots_u = 3;
+    nurbs_nonrational.highest_index_of_knots_v = 3;
+    nurbs_nonrational.p = cp_nonrational;
+    nurbs_nonrational.knot_vector_u = knots_u;
+    nurbs_nonrational.knot_vector_v = knots_v;
+
+    /* Face 1: rational patch, same corner positions, unequal weights so the
+       rational-vs-affine difference actually shows up if control_w were
+       dropped or mishandled. */
+    cp_rational[0] = (prc_control_points_nurbs_surf){ 0.0, 0.0, 0.0, 1.0 };
+    cp_rational[1] = (prc_control_points_nurbs_surf){ 0.0, 1.0, 2.0, 2.0 };
+    cp_rational[2] = (prc_control_points_nurbs_surf){ 1.0, 0.0, 5.0, 0.5 };
+    cp_rational[3] = (prc_control_points_nurbs_surf){ 1.0, 1.0, -3.0, 3.0 };
+
+    nurbs_rational.tag = PRC_TYPE_SURF_NURBS;
+    nurbs_rational.is_rational = 1;
+    nurbs_rational.du = 1;
+    nurbs_rational.dv = 1;
+    nurbs_rational.highest_index_of_control_points_u = 1;
+    nurbs_rational.highest_index_of_control_points_v = 1;
+    nurbs_rational.highest_index_of_knots_u = 3;
+    nurbs_rational.highest_index_of_knots_v = 3;
+    nurbs_rational.p = cp_rational;
+    nurbs_rational.knot_vector_u = knots_u;
+    nurbs_rational.knot_vector_v = knots_v;
+
+    faces[0].surface_geometry.surface.surface_type = PRC_TYPE_SURF_NURBS;
+    faces[0].surface_geometry.surface.surf_nurbs = &nurbs_nonrational;
+    faces[1].surface_geometry.surface.surface_type = PRC_TYPE_SURF_NURBS;
+    faces[1].surface_geometry.surface.surf_nurbs = &nurbs_rational;
+
+    face_topos[0].topo_face = &faces[0];
+    face_topos[1].topo_face = &faces[1];
+
+    face_slots[0].face.is_stored = 0;
+    face_slots[0].face.topo = &face_topos[0];
+    face_slots[1].face.is_stored = 0;
+    face_slots[1].face.topo = &face_topos[1];
+
+    shell.number_of_faces = 2;
+    shell.faces = face_slots;
+
+    shell_topo.topo_shell = &shell;
+
+    shell_ptr.is_stored = 0;
+    shell_ptr.topo = &shell_topo;
+
+    connex.number_of_shells = 1;
+    connex.shells = &shell_ptr;
+
+    connex_topo.topo_connex = &connex;
+
+    connex_ptr.is_stored = 0;
+    connex_ptr.topo = &connex_topo;
+
+    brep_data.tag = PRC_TYPE_TOPO_BrepData;
+    brep_data.number_of_connex = 1;
+    brep_data.connex = &connex_ptr;
+
+    body.tag = PRC_TYPE_TOPO_BrepData;
+    body.topo_brep_data = &brep_data;
+
+    tc.number_of_bodies = 1;
+    tc.bodies = &body;
+
+    geom.exact_geometry.topo_context_count = 1;
+    geom.exact_geometry.topo_contexts = &tc;
+
+    fs.geometry = &geom;
+
+    data.file_structure_count = 1;
+    data.file_struct = &fs;
+
+    /* 1. Indexing. */
+    n_bodies = prc_api_get_number_brep_bodies(ctx, (prc_api_data)&data);
+    CHECK(n_bodies == 1, "expected 1 brep body");
+    n_shells = prc_api_get_number_brep_shells(ctx, (prc_api_data)&data, 0);
+    CHECK(n_shells == 1, "expected 1 shell");
+    n_faces = prc_api_get_number_brep_faces(ctx, (prc_api_data)&data, 0, 0);
+    CHECK(n_faces == 2, "expected 2 faces");
+
+    {
+        uint32_t f;
+        for (f = 0; f < 2; f++)
+        {
+            prc_api_surface_type type = PRC_API_SURFACE_UNKNOWN;
+            prc_api_nurbs_surface surf;
+            double p00[3], p01[3], p10[3], p11[3];
+            double w00, w01, w10, w11;
+            double expect[3], got[3];
+            int i;
+
+            code = prc_api_get_face_surface_type(ctx, (prc_api_data)&data, 0, 0, f, &type);
+            CHECK(code == 0, "get_face_surface_type failed");
+            CHECK(type == PRC_API_SURFACE_NURBS, "expected NURBS type");
+
+            code = prc_api_get_face_nurbs_surface(ctx, (prc_api_data)&data, 0, 0, f, &surf);
+            CHECK(code == 0, "get_face_nurbs_surface failed");
+
+            CHECK(surf.degree_u == 1 && surf.degree_v == 1, "degree mismatch");
+            CHECK(surf.num_control_points_u == 2 && surf.num_control_points_v == 2, "control point count mismatch");
+            CHECK(surf.num_knots_u == 4 && surf.num_knots_v == 4, "knot count mismatch");
+            CHECK(surf.is_rational == (f == 1), "is_rational mismatch");
+
+            for (i = 0; i < 4; i++)
+                CHECK(surf.knot_vector_u[i] == knots_u[i] && surf.knot_vector_v[i] == knots_v[i], "knot value mismatch");
+
+            {
+                prc_control_points_nurbs_surf *src = (f == 0) ? cp_nonrational : cp_rational;
+                for (i = 0; i < 4; i++)
+                {
+                    CHECK(surf.control_x[i] == src[i].x, "control_x mismatch");
+                    CHECK(surf.control_y[i] == src[i].y, "control_y mismatch");
+                    CHECK(surf.control_z[i] == src[i].z, "control_z mismatch");
+                    if (f == 0)
+                        CHECK(surf.control_w[i] == 1.0, "non-rational control_w should normalize to 1.0");
+                    else
+                        CHECK(surf.control_w[i] == src[i].w, "rational control_w mismatch");
+                }
+            }
+
+            p00[0] = surf.control_x[0]; p00[1] = surf.control_y[0]; p00[2] = surf.control_z[0]; w00 = surf.control_w[0];
+            p01[0] = surf.control_x[1]; p01[1] = surf.control_y[1]; p01[2] = surf.control_z[1]; w01 = surf.control_w[1];
+            p10[0] = surf.control_x[2]; p10[1] = surf.control_y[2]; p10[2] = surf.control_z[2]; w10 = surf.control_w[2];
+            p11[0] = surf.control_x[3]; p11[1] = surf.control_y[3]; p11[2] = surf.control_z[3]; w11 = surf.control_w[3];
+
+            /* Corners must reproduce exactly, interior point via the independent closed form. */
+            bilinear(0.0, 0.0, p00, w00, p01, w01, p10, w10, p11, w11, got);
+            CHECK(fabs(got[0] - p00[0]) < 1e-12 && fabs(got[1] - p00[1]) < 1e-12 && fabs(got[2] - p00[2]) < 1e-12, "corner (0,0) mismatch");
+
+            bilinear(1.0, 1.0, p00, w00, p01, w01, p10, w10, p11, w11, got);
+            CHECK(fabs(got[0] - p11[0]) < 1e-12 && fabs(got[1] - p11[1]) < 1e-12 && fabs(got[2] - p11[2]) < 1e-12, "corner (1,1) mismatch");
+
+            bilinear(0.5, 0.5, p00, w00, p01, w01, p10, w10, p11, w11, expect);
+            printf("face=%u is_rational=%u interior(0.5,0.5)=(%.6f,%.6f,%.6f)\n",
+                f, surf.is_rational, expect[0], expect[1], expect[2]);
+
+            prc_api_release_nurbs_surface(ctx, &surf);
+        }
+    }
+
+    /* Out-of-range indices must fail cleanly rather than reading garbage. */
+    {
+        prc_api_surface_type type;
+        code = prc_api_get_face_surface_type(ctx, (prc_api_data)&data, 1, 0, 0, &type);
+        CHECK(code < 0, "expected error for out-of-range body_index");
+        code = prc_api_get_face_surface_type(ctx, (prc_api_data)&data, 0, 1, 0, &type);
+        CHECK(code < 0, "expected error for out-of-range shell_index");
+        code = prc_api_get_face_surface_type(ctx, (prc_api_data)&data, 0, 0, 2, &type);
+        CHECK(code < 0, "expected error for out-of-range face_index");
+    }
+
+    prc_api_release_context(ctx);
+
+    printf(g_bad == 0 ? "RESULT: PASS\n" : "RESULT: FAIL (%d problem(s))\n", g_bad);
+    return g_bad == 0 ? 0 : 1;
+}
