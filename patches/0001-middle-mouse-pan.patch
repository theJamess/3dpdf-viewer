From f5535d6958491d5b00b49c816a56e69dee9e3f86 Mon Sep 17 00:00:00 2001
From: 3dpdf <3dpdf@users.noreply.github.com>
Date: Fri, 18 Sep 2026 16:54:12 +0000
Subject: [PATCH] Add middle-mouse-button pan to the viewer

Left-drag rotates (arcball) and the wheel zooms by scaling the product
matrix; middle-drag now pans by translating it using the camera's own
right()/up() vectors (the same ones WASD movement uses), so the model
follows the cursor directly, like grabbing it. The pan delta is
measured from the button-down anchor to the live cursor position each
frame (not accumulated), matching how the arcball recomputes its full
rotation from press-start every frame, and scaled by the orbit-center
distance and vertical FOV so the model tracks the cursor consistently
regardless of zoom level.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 demos/viewer/src/main.cpp | 56 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/demos/viewer/src/main.cpp b/demos/viewer/src/main.cpp
index d2e5702..cf3689c 100644
--- a/demos/viewer/src/main.cpp
+++ b/demos/viewer/src/main.cpp
@@ -21,6 +21,7 @@
 #include <cstring>
 #include <limits>
 #include <cmath>
+#include <algorithm>
 
 #include <SDL3/SDL.h>
 
@@ -937,6 +938,10 @@ static void run(Config &config, SDL_Window *window, const char *file, bool headl
     int pickX = 0;
     int pickY = 0;
     int mouseX_buttondown, mouseY_buttondown;
+    bool middleMouseDown = false;
+    int panAnchorX = 0, panAnchorY = 0;
+    int panLiveX = 0, panLiveY = 0;
+    Matrix4 panCurrMat;
     Matrix4 curr_mat;
     Matrix4 transToCenter = Matrix4(1.0f);
     Matrix4 transFromCenter = Matrix4(1.0f);
@@ -1056,6 +1061,11 @@ static void run(Config &config, SDL_Window *window, const char *file, bool headl
                     mouseX_buttondown = evt.motion.x;
                     mouseY_buttondown = evt.motion.y;
                 }
+                if (middleMouseDown)
+                {
+                    panLiveX = (int)evt.motion.x;
+                    panLiveY = (int)evt.motion.y;
+                }
                 break;
             case SDL_EVENT_MOUSE_WHEEL:
                 curr_mat = _scene.models()[0].model();
@@ -1067,6 +1077,13 @@ static void run(Config &config, SDL_Window *window, const char *file, bool headl
                     curr_mat = _scene.models()[0].model();
                     mouseDown = true;
                 }
+                else if (evt.button.button == SDL_BUTTON_MIDDLE)
+                {
+                    panCurrMat = _scene.models()[0].model();
+                    middleMouseDown = true;
+                    panAnchorX = panLiveX = (int)evt.button.x;
+                    panAnchorY = panLiveY = (int)evt.button.y;
+                }
                 break;
             case SDL_EVENT_MOUSE_BUTTON_UP:
                 if (evt.button.button == SDL_BUTTON_LEFT)
@@ -1091,6 +1108,10 @@ static void run(Config &config, SDL_Window *window, const char *file, bool headl
                     }
                     mouseDown = false;
                 }
+                else if (evt.button.button == SDL_BUTTON_MIDDLE)
+                {
+                    middleMouseDown = false;
+                }
                 break;
             }
         }
@@ -1118,6 +1139,41 @@ static void run(Config &config, SDL_Window *window, const char *file, bool headl
         float pitch = _camera.pitch();
         float yaw = _camera.yaw();
 
+        /* Middle-mouse-drag pan: translate the product using the camera's
+           own right()/up() vectors (the same ones WASD movement uses), so
+           the model directly follows the cursor -- drag right and the
+           model moves right on screen, like grabbing it. The delta is
+           always measured from the button-down anchor to the live
+           position (not accumulated frame-to-frame), matching how the
+           arcball recomputes its full rotation from press-start each
+           frame. */
+        if (middleMouseDown && mouseMoved && !mouse_over_debug)
+        {
+            int windowWidth, windowHeight;
+            SDL_GetWindowSizeInPixels(window, &windowWidth, &windowHeight);
+
+            float dx = (float)(panLiveX - panAnchorX);
+            float dy = (float)(panLiveY - panAnchorY);
+
+            /* World units per pixel at the orbit-center distance, so the
+               model tracks the cursor consistently regardless of zoom. */
+            float halfFovY = mutil::radians(_camera.fov()) * 0.5f;
+            float distance = (float)(std::fabs(camZCenter) > 1e-6 ? std::fabs(camZCenter) : 10.0);
+            float worldPerPixel = (2.0f * distance * std::tan(halfFovY)) / (float)std::max(1, windowHeight);
+
+            /* +X is screen-right (move along +right()); screen Y grows
+               downward while up() points to screen-up, hence the negation
+               on dy so dragging down moves the model down. */
+            Vector3 worldDelta = (dx * worldPerPixel) * _camera.right() -
+                (dy * worldPerPixel) * _camera.up();
+
+            Matrix4 panTrans = Matrix4(1.0f);
+            panTrans = mutil::translate(panTrans, worldDelta);
+
+            _scene.models()[0].setModel(panTrans * panCurrMat);
+            mouseMoved = false;
+        }
+
         /* This is an arcball or trackball implementation for rotating the 3D part
            with the mouse. Math from Ken Shoemake 1992 */
         if ((mouseDown && mouseMoved && !mouse_over_debug) || mouse_wheel_delta != 0)
