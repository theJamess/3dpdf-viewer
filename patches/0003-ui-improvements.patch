+/* Reads back the current framebuffer and writes it to a PNG. Shared by
+   batch-mode (--output) and the interactive F12/"Save Screenshot" action. */
+static bool saveScreenshotPNG(const char *path, int w, int h)
+{
+    int channels = 3; // RGB
+    int stride = channels * w;
+    stride += (stride % 4) ? (4 - stride % 4) : 0; // Align to 4 bytes
+    unsigned char *pixels = new unsigned char[stride * h];
+
+    glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, pixels);
+
+    // Flip image vertically (OpenGL's origin is bottom-left, image formats use top-left)
+    unsigned char *flipped = new unsigned char[stride * h];
+    for (int y = 0; y < h; y++)
+    {
+        memcpy(flipped + y * stride, pixels + (h - 1 - y) * stride, stride);
+    }
+
+    bool ok = stbi_write_png(path, w, h, channels, flipped, stride) != 0;
+
+    delete[] pixels;
+    delete[] flipped;
+
+    return ok;
+}
