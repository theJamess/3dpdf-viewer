# Simple 3D PDF viewer launcher for Ubuntu.
#
# Opens a PDF that has an embedded PRC 3D model (a "3D PDF" as produced by
# CAD/engineering tools such as Tetra4D, 3D-Tool, SolidWorks' 3D-PDF export,
# CAD Exchanger, etc.) in an interactive viewer. Left-drag to rotate,
# middle-drag to pan, scroll to zoom. See README.md for the full control
# list and the Section (clipping plane) feature.
#
# Usage:
#   3dpdf-view [file.pdf]
#
# If no file is given, a file-picker dialog is shown (requires zenity).
set -euo pipefail

# Resolve our OWN real path first: setup.sh symlinks this script into
# ~/.local/bin so it works from anywhere, and dirname on a symlink's own
# path (not its target) would otherwise compute the wrong REPO_ROOT.
SELF="${BASH_SOURCE[0]}"
if command -v realpath >/dev/null 2>&1; then
    SELF="$(realpath "$SELF")"
else
    SELF="$(readlink -f "$SELF")"
fi

REPO_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
VIEWER_BIN="$REPO_ROOT/third_party/nanoPRC/build/bin/nano_prc_viewer"
RUN_DIR="$REPO_ROOT/third_party/nanoPRC/build/bin"

# This same script also ships inside the .deb package (scripts/build-deb.sh)
# installed at /usr/bin/3dpdf-view, where the repo-relative path above
# doesn't exist -- the packaged binary lives at a fixed FHS path instead.
# Fall back to that rather than duplicating this whole script for the two
# cases.
if [[ ! -x "$VIEWER_BIN" ]]; then
    PACKAGED_BIN="/usr/lib/3dpdf-viewer/nano_prc_viewer"
    if [[ -x "$PACKAGED_BIN" ]]; then
        VIEWER_BIN="$PACKAGED_BIN"
        # Not /usr/lib/3dpdf-viewer itself: that's root-owned in a package
        # install, and the viewer writes its settings (viewer.ini) to
        # whatever directory it's run from with no way to redirect that --
        # give it a real, per-user writable one instead.
        RUN_DIR="$HOME/.local/share/3dpdf-viewer"
        mkdir -p "$RUN_DIR"
    else
        echo "3dpdf-view: viewer binary not found at $VIEWER_BIN" >&2
        echo "Run '$REPO_ROOT/scripts/setup.sh' first to install dependencies and build it." >&2
        exit 1
    fi
fi

FILE="${1:-}"

if [[ -z "$FILE" ]]; then
    if command -v zenity >/dev/null 2>&1; then
        FILE="$(zenity --file-selection --title="Open a 3D PDF" --file-filter="PDF files | *.pdf *.PDF" 2>/dev/null || true)"
        if [[ -z "$FILE" ]]; then
            echo "3dpdf-view: no file selected." >&2
            exit 1
        fi
    else
        echo "Usage: 3dpdf-view <file.pdf>" >&2
        echo "(install 'zenity' to get a graphical file picker when no argument is given)" >&2
        exit 1
    fi
fi

if [[ ! -f "$FILE" ]]; then
    echo "3dpdf-view: file not found: $FILE" >&2
    exit 1
fi

# Resolve to an absolute path before changing directory below.
FILE="$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")"

# Run from RUN_DIR so it finds/writes its viewer.ini there instead of
# cluttering the caller's working directory.
cd "$RUN_DIR"

# Deliberately not `exec`ing the viewer here (unlike before): a failure needs
# to be caught below to show a dialog, since launching via a file manager's
# "Open With" (the main reason MimeType=application/pdf is registered at
# all -- see README.md's "Controls"/Setup sections) gives the user no
# terminal to see nanoPRC's own stderr error on. Without this, a PDF with no
# embedded 3D content just flashes a window and vanishes with zero
# explanation.
set +e
"$VIEWER_BIN" "$FILE" "${@:2}"
status=$?
set -e

if [[ $status -ne 0 ]]; then
    echo "3dpdf-view: failed to open '$FILE' (exit $status)" >&2
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="3D PDF Viewer" --text="Couldn't open:\n$FILE\n\nThis viewer only handles PDFs with an embedded PRC 3D model (the kind CAD/engineering tools produce) -- if this is a regular PDF, that's almost certainly why. Run 3dpdf-view from a terminal for the full error output." 2>/dev/null || true
    fi
    exit "$status"
fi
